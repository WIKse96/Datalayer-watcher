{
  "manifest_version": 3,
  "name": "DataLayer Watcher",
  "version": "1.1.0",
  "description": "Przechwytuje i zapisuje w czasie rzeczywistym WSZYSTKIE eventy pushowane do window.dataLayer (GTM/GA4) — także te wypychane tuż przed przeładowaniem strony (klasyczny WooCommerce add_to_cart).",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DataLayer Watcher"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
